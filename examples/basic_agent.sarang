// A minimal Sarang agent definition.
// This file will be parseable after Phase 5.

agent BasicAssistant {
    model primary {
        provider: "openai"
        name: "gpt-4"
        temperature: 0.7
    }

    safety {
        block: ["harmful_content", "pii_leak"]
    }

    output {
        format: "markdown"
        max_tokens: 4096
    }
}
